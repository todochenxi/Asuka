# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境
.venv/
venv/
env/

# 测试 / 覆盖率
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# AgentOS 运行时产物
# ---------------------------------------------------------------------------
# 心跳文件（K8s liveness 探针读它，每次运行生成）
*.heartbeat

# 运行日志
*.log

# 评估平台跑出来的基线 —— 每次真跑都会覆盖，且绑定具体集群，不进版本库
deploy/config/baseline.json

# ---------------------------------------------------------------------------
# Agent 工具链工作区（含会话记忆，属本地状态，不是交付物）
# ---------------------------------------------------------------------------
# 排查用的临时落盘（集成测试连跑日志、变异脚本、备份……）
# 刻意不进版本库：它们是**过程证据**，不是结论。
# 结论写进基线文档，过程用完即弃。
.workbuddy-ai/tmp/

# ---------------------------------------------------------------------------
# 本地密钥 / 启动配置
# ---------------------------------------------------------------------------
# 只在本机使用；不要把 API key 写进已跟踪的源码文件。
.env.local
*.local.env
apps/api/.env

# ---------------------------------------------------------------------------
# Asuka：本地模型权重（bge-m3，约 2.1GB）
# ---------------------------------------------------------------------------
# 不进版本库 —— 它是**可重新下载的资产**，不是源码。
# 来源、下载命令与校验和记在 asuka/models/README.md（那个文件进版本库）。
# 约定目录：ASUKA_EMBED_MODEL_PATH=.asuka-models/bge-m3
.asuka-models/

# Asuka：评估跑出来的产物（报告 / trace / 检索结果 / 回归对照）
# 每次真跑都会覆盖，且绑定具体语料与配置，不进版本库 —— 它们是过程证据。
# 复现它们的命令记在 asuka/README.md。
asuka/runs/
